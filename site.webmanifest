{
  "name": "SSH Monitor",
  "short_name": "SSHMonitor",
  "description": "Free Bash script that emails you when failed SSH logins pass a threshold, from the Forward Email team.",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#ffffff",
  "theme_color": "#1a365d",
  "icons": [
    { "src": "/images/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/images/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/images/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
